# Copy to .env.local and fill in. Never commit .env.local.

# URL that accepts POST {"email": "...", "source": "landing-hero"} — Formspree,
# Buttondown, ConvertKit, a serverless function, or your own handler.
#
# Leave it empty and signups are kept in the visitor's browser (localStorage)
# only. That keeps the form working while you build, but collects nothing —
# set this before you send anyone to the page.
VITE_WAITLIST_ENDPOINT=
